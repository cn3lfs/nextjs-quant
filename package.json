{
  "name": "nextjs-quant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm trading-strategy-core:build && pnpm trading-strategies:build && pnpm runtime:build && next build",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "pnpm trading-strategy-core:build && pnpm trading-strategies:build && pnpm runtime:build && next dev --hostname 127.0.0.1",
    "preview": "pnpm build && pnpm desktop:prepare && pnpm start",
    "start": "node scripts/start.mjs",
    "typecheck": "pnpm trading-strategy-core:build && pnpm trading-strategies:build && pnpm tstdx:build && tsc --noEmit",
    "runtime:build": "pnpm tstdx:build && node scripts/build-runtime.mjs",
    "test": "pnpm trading-strategy-core:build && pnpm trading-strategies:build && pnpm tstdx:build && vitest run && pnpm --filter trading-strategies test && pnpm --filter trading-strategy-core test",
    "check": "pnpm typecheck && pnpm test",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:dev": "pnpm build && pnpm desktop:prepare && electron .",
    "desktop:pack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pack-desktop.ps1",
    "format:check": "prettier --check src electron scripts tests *.ts *.js *.json *.yml packages/tstdx/src packages/tstdx/tests packages/tstdx/*.ts packages/tstdx/*.json packages/trading-strategies/src packages/trading-strategies/tests packages/trading-strategies/*.ts packages/trading-strategies/*.json packages/trading-strategy-core/src packages/trading-strategy-core/tests packages/trading-strategy-core/*.ts packages/trading-strategy-core/*.json",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "smoke:data": "tsx scripts/smoke.ts",
    "tstdx:build": "pnpm --dir packages/tstdx build",
    "tstdx:test": "pnpm --dir packages/tstdx test",
    "verify:spot": "tsx scripts/verify.ts spot",
    "verify:batch": "tsx scripts/verify.ts batch",
    "normalize:eol": "tsx scripts/normalize-eol.ts",
    "trading-strategies:build": "pnpm --filter trading-strategies build",
    "trading-strategy-core:build": "pnpm --filter trading-strategy-core build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.69.0",
    "@tanstack/react-table": "^9.2.4",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "better-sqlite3": "^13.0.3",
    "big.js": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.41.0",
    "fetch-socks": "^1.3.3",
    "koffi": "^3.2.1",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.42.0",
    "next": "^16.3.4",
    "openai": "^7.10.0",
    "pinyin-pro": "^3.29.3",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "smol-toml": "^1.8.0",
    "superjson": "^2.2.1",
    "tailwind-merge": "^3.6.0",
    "tstdx": "workspace:*",
    "undici": "^7.29.1",
    "zod": "^3.24.2",
    "trading-strategies": "workspace:*",
    "trading-strategy-core": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.15",
    "@types/better-sqlite3": "^9.6.0",
    "@types/big.js": "^7.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.30.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.15",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "vitest": "^5.0.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "pnpm@9.15.9",
  "main": "desktop/main.cjs",
  "description": "Local quantitative research workbench",
  "author": "Quant Workbench"
}

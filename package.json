{
  "name": "nextjs-quant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "quant:team": "tsx scripts/quant-team.ts",
    "build": "pnpm runtime:build && next build",
    "packages:build": "pnpm -r --workspace-concurrency=1 --filter \"./packages/*\" run build",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "pnpm runtime:build && next dev --hostname 127.0.0.1",
    "preview": "pnpm build && pnpm desktop:prepare && pnpm start",
    "start": "node scripts/start.mjs",
    "typecheck": "pnpm packages:build && tsc --noEmit",
    "tdx:import": "tsx scripts/import-tdx-five-minute.ts",
    "tdx:audit": "tsx scripts/audit-tdx-five-minute.ts",
    "tdx:repair-zero-volume": "tsx scripts/repair-tdx-zero-volume.ts",
    "tdx:estimate-zero-volume": "tsx scripts/estimate-tdx-zero-volume.ts",
    "wdz:extract": "tsx scripts/extract-wdz.ts",
    "wdz:import": "tsx scripts/import-wdz-five-minute.ts",
    "wdz:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-wdz.ps1",
    "native:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-tdx-import.ps1",
    "runtime:build": "pnpm packages:build && node scripts/build-runtime.mjs",
    "test": "pnpm runtime:build && vitest run && pnpm --filter trading-strategies test && pnpm --filter trading-strategy-core test && pnpm backtest-engine:test && pnpm performance:test && pnpm tstdx:test && pnpm --filter quant-execution test && pnpm rps:test",
    "lint": "eslint src \"packages/*/src/**/*.{ts,tsx}\"",
    "check:dependencies": "tsx scripts/check-dependencies.ts",
    "e2e": "playwright test --project workbench",
    "e2e:p0": "playwright test --project p0",
    "e2e:daily": "playwright test --project daily",
    "e2e:p1": "playwright test --project p1",
    "e2e:visual": "playwright test --project visual",
    "check": "node scripts/check.mjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:dev": "pnpm build && pnpm desktop:prepare && electron .",
    "desktop:pack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pack-desktop.ps1",
    "format:check": "prettier --check src electron scripts tests *.ts *.js *.json *.yml packages/tstdx/src packages/tstdx/tests packages/tstdx/*.ts packages/tstdx/*.json packages/trading-strategies/src packages/trading-strategies/tests packages/trading-strategies/*.ts packages/trading-strategies/*.json packages/trading-strategy-core/src packages/trading-strategy-core/tests packages/trading-strategy-core/*.ts packages/trading-strategy-core/*.json packages/quant-backtest/src packages/quant-backtest/tests packages/quant-backtest/*.ts packages/quant-backtest/*.json packages/quant-performance/src packages/quant-performance/tests packages/quant-performance/*.ts packages/quant-performance/*.json packages/quant-execution/src packages/quant-execution/tests packages/quant-execution/*.ts packages/quant-execution/*.json packages/quant-rps/src packages/quant-rps/tests packages/quant-rps/*.ts packages/quant-rps/*.json",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "smoke:data": "tsx scripts/smoke.ts",
    "tstdx:build": "pnpm --dir packages/tstdx build",
    "tstdx:test": "pnpm --dir packages/tstdx test",
    "verify:spot": "tsx scripts/verify.ts spot",
    "verify:batch": "tsx scripts/verify.ts batch",
    "normalize:eol": "tsx scripts/normalize-eol.ts",
    "trading-strategies:build": "pnpm --filter trading-strategies build",
    "trading-strategy-core:build": "pnpm --filter trading-strategy-core build",
    "test:browser": "node scripts/run-browser-harness.mjs",
    "backtest-engine:build": "pnpm --filter quant-backtest build",
    "backtest-engine:test": "pnpm --filter quant-backtest test",
    "performance:build": "pnpm --filter quant-performance build",
    "performance:test": "pnpm --filter quant-performance test",
    "performance:typecheck": "pnpm --filter quant-performance typecheck",
    "rps:build": "pnpm --filter quant-rps build",
    "rps:test": "pnpm --filter quant-rps test",
    "e2e:paper": "playwright test --project paper",
    "e2e:accounts": "playwright test --project accounts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/query-async-storage-persister": "^5.103.2",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-query-persist-client": "^5.103.2",
    "@tanstack/react-table": "^9.2.4",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "better-sqlite3": "^13.0.3",
    "big.js": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.41.0",
    "fetch-socks": "^1.3.3",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "koffi": "^3.2.1",
    "lightweight-charts": "^5.2.1",
    "next": "^16.3.4",
    "openai": "^7.10.0",
    "pinyin-pro": "^3.29.3",
    "quant-backtest": "workspace:*",
    "quant-execution": "workspace:*",
    "quant-performance": "workspace:*",
    "quant-rps": "workspace:*",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "smol-toml": "^1.8.0",
    "superjson": "^2.2.1",
    "tailwind-merge": "^3.6.0",
    "trading-strategies": "workspace:*",
    "trading-strategy-core": "workspace:*",
    "tstdx": "workspace:*",
    "undici": "^7.29.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@dagrejs/graphlib": "4.0.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/better-sqlite3": "^9.6.0",
    "@types/big.js": "^7.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dependency-cruiser": "18.7.2",
    "drizzle-kit": "^0.30.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.15",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "pnpm@9.15.9",
  "main": "desktop/main.cjs",
  "description": "Local quantitative research workbench",
  "author": "Quant Workbench"
}

{
  "name": "nextjs-quant",
  "runRoot": ".test-data/fleet",
  "isolatedDataEnv": "QUANT_DATA_DIR",
  "protectedPaths": [],
  "defaultModels": {
    "complex": "gpt-6.2-astra",
    "complexEffort": "high",
    "review": "gpt-6.2-sol",
    "reviewEffort": "high",
    "everydayFast": "claude-deepseek:default",
    "everydayEfficient": "gpt-6.2-sol",
    "everydayEffort": "high",
    "agyModel": "gemini-4-neon-high"
  },
  "timeouts": {
    "defaultMs": 900000,
    "complexMs": 1500000,
    "reviewMs": 600000,
    "idleStallMs": 300000
  },
  "resilience": {
    "maxRetries": 1,
    "allowFallback": true
  },
  "claudePolicy": {
    "forbidModelOverride": true,
    "stripEnv": ["ANTHROPIC_MODEL"],
    "permissionMode": "bypassPermissions"
  }
}

{
  "name": "tstdx",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone TypeScript TongDaXin TCP market data client",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wire": {
      "types": "./dist/wire.d.ts",
      "import": "./dist/wire.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "iconv-lite": "0.7.3"
  }
}

{
  "name": "trading-strategy-core",
  "version": "0.1.0",
  "private": true,
  "description": "Pure shared primitives for the Guanlan strategy services",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bars": {
      "types": "./dist/bars.d.ts",
      "import": "./dist/bars.js"
    },
    "./indicators": {
      "types": "./dist/indicators.d.ts",
      "import": "./dist/indicators.js"
    },
    "./completed-bars": {
      "types": "./dist/completed-bars.d.ts",
      "import": "./dist/completed-bars.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "import": "./dist/money.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "big.js": "7.0.1"
  }
}
